# Heavy data — regenerated by pipeline
data/pdb/*.pdb
data/pdb/*.cif
data/af/*.pdb
data/prepared/*.pdbqt
data/prepared/*.pqr
data/prepared/*.pdb

# Ligand artifacts — regenerated by ligands/prepare_as3.sh
ligands/as3.pdbqt

# Heavy / interactive outputs — regenerable, keep out of git
results/figures/*.svg
results/figures/*.pse
results/docking_poses/
results/tmp/

# Pipeline outputs that ARE tracked in git (figures + tables for thesis):
#   results/*.tsv                — already not ignored
#   results/REPORT.md            — already not ignored
#   results/figures/*.png        — figure PNGs for thesis chapter
#   results/figures/*.pml        — PyMOL scripts (small text, reproducible)
# These are intentionally left tracked so the chapter at docs/chapter_in_silico.md
# can reference them directly from the repo.

# Allow small reference / example files
!data/pdb/.gitkeep
!data/af/.gitkeep
!data/prepared/.gitkeep
!results/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Conda / venv
env/.conda/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
