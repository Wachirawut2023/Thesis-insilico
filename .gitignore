# Heavy data — regenerated by pipeline
data/pdb/*.pdb
data/pdb/*.cif
data/af/*.pdb
data/prepared/*.pdbqt
data/prepared/*.pqr
data/prepared/*.pdb
results/figures/*.png
results/figures/*.svg
results/figures/*.pse
results/docking_poses/
results/tmp/

# Allow small reference / example files
!data/pdb/.gitkeep
!data/af/.gitkeep
!data/prepared/.gitkeep
!results/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Conda / venv
env/.conda/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
